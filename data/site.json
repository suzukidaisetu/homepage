e5677f1","no":"17","t":"スクリーンショット 2026-09-30 18.56.23","s":"","ar":1.8293},{"img":"b7db128fcb2123f84e0c8814b7e0aabe","no":"18","t":"スクリーンショット 2026-09-30 19.09.02","s":"","ar":1.8237},{"img":"67bf30f2119cb9c57ae31c6349b22f3b","no":"19","t":"詳細平面図１","s":"","ar":0.5922},{"img":"ae09baf6913dba07cf9355d8b7dcb25a","no":"20","t":"敷地配置図(2)","s":"","ar":1.3544},{"img":"cb94f8cbc11e22f075926e3ac29c6749","no":"21","t":"保育園断面１","s":"","ar":4.0268},{"img":"1a45d01ca64eadf97265b41a3687390e","no":"22","t":"保育園長手断面","s":"","ar":5.2941}],"text":{"ja":{"title":"骨組みとしての住棟","body":["川沿いに伸びる一本の長い住棟。円形の中庭を一定の間隔で挟み込み、住戸と共用の場が交互に現れる。","構造フレームを外に露出させ、設備や階段、植栽が後から取り付いていく余地を残した。建物を完成品ではなく、住み手が手を加え続ける骨組みとして考えている。"]},"en":{"title":"A Frame to Live In","body":["One long housing block runs along the river. Round courtyards are set into it at a steady rhythm, so homes and shared spaces alternate.","The structural frame is left exposed, with room for services, stairs and planting to attach over time. The building is treated as a frame its residents keep adding to, not a finished object."]}}},{"no":"006","title":"Elevated Deck","period":"2024","type":"Studio","tag":"Infrastructure","cover":0,"sheets":[{"img":"4a04938df4b81b43bdaea31cff032352","no":"01","t":"Roof deck","s":"","ar":1.7769},{"img":"7588dbd36f4080ad52482f721ac65e17","no":"02","t":"Long elevation","s":"","ar":1.7769},{"img":"14ff3d8964f2ee8de5f48494cd38bb52","no":"03","t":"Short elevation","s":"","ar":1.8967}],"text":{"ja":{"title":"持ち上げられた広場","body":["地上から持ち上げられた細長いデッキと、その上に並ぶヴォールト屋根の小屋。","細い柱で地面との接点を減らし、下を風と人が抜けていく。屋上は誰もが歩ける広場として開き、小屋はそこに寄り添う休憩所になる。"]},"en":{"title":"A Raised Square","body":["A long deck lifted off the ground, with small vaulted huts along its top.","Thin columns keep contact with the ground to a minimum, so wind and people pass underneath. The roof opens as a square anyone can walk on, and the huts become shelters beside it."]}}},{"no":"005","title":"nowhere-minutes","period":"2026","type":"competition","tag":"public","cover":0,"sheets":[{"img":"ea07707cbfbe188ee8f75ba42c4f227c","no":"01","t":"海＿パース１","s":"","ar":1},{"img":"a80758102719b7efb184bae6d3bc9b23","no":"02","t":"海＿パース２","s":"","ar":1},{"img":"ffbaf3d59dd2169167ed2e55a2a2548d","no":"03","t":"海＿断面図","s":"","ar":1},{"img":"3d043a2efe3757e76aa6aea772302459","no":"04","t":"海＿配置図","s":"","ar":1},{"img":"66561086e44f568261f03150da01966b","no":"05","t":"海＿平面図１","s":"","ar":1},{"img":"de366d1f2e24813f66fe9fc8671a629f","no":"06","t":"海＿平面図２","s":"","ar":1},{"img":"3e27c39072b165c3e1dbb3e05c4b5c9b","no":"07","t":"海＿平面図３","s":"","ar":1},{"img":"d188b90407fbb080dfbb72395d906263","no":"08","t":"街＿パース１","s":"","ar":1},{"img":"aa25465cb8852e1207e3bd76034f4157","no":"09","t":"街＿パース２","s":"","ar":1},{"img":"4d2a902184f4166dac058bceae075917","no":"10","t":"街＿断面図","s":"","ar":1},{"img":"7b9f2aa43220484c5b2860b52e53d1b9","no":"11","t":"街＿配置図","s":"","ar":1},{"img":"48b64a924f87e008fc05dbea9d51e48d","no":"12","t":"街＿平面図１","s":"","ar":1},{"img":"0c4a92fe0644d6d900ce9945c4091e8d","no":"13","t":"街＿平面図２","s":"","ar":1},{"img":"036e3d19159a7741e9252c10be6727e1","no":"14","t":"森＿パース１","s":"","ar":1},{"img":"a45d2e8775e0e5f42b1e199a15deb0ec","no":"15","t":"森＿パース２","s":"","ar":1},{"img":"0c7e352bd2e50a5fc414e5aaeb2b37b8","no":"16","t":"森＿断面図","s":"","ar":1},{"img":"e89e067aff77b0adde7677c5fef1c327","no":"17","t":"森＿配置図","s":"","ar":1},{"img":"42fac884598d34fcaf1aae2ef58b4ae8","no":"18","t":"森＿平面図","s":"","ar":1}],"text":{"ja":{"title":"テーマ","body":["現代の効率化された移動そのものに豊かさを見いだし得るならば、その途上に存在する中立的な状態には、最も他律的で無意識的なものとして、新たな価値が認められる。","夜行バスの旅程で立ち寄るパーキングエリアは、場所や時間が匿名的で、現象を相対化させる情報が存在しない。移動を中断した旅行者たちはそこで、20分程の許されたあいだ、薄闇の中を取り留めなく彷徨う。そのような状態をとらえ、逃さないように、空間を与える。柔らかな非現実感の中、目の前の現象にただ身を委ねられるような場を構想した。"]},"en":{"title":"Thema","body":["If richness can be found in modern, streamlined mobility itself, then the neutral state existing along its course reveals a new value as something profoundly passive and unconscious. The highway parking areas where night buses stop are anonymous in time and space, devoid of any information that might contextualize the experience. There, travelers whose journeys are briefly paused wander aimlessly through the dim light for their allotted twenty minutes. To capture and retain this transient state, I gave it physical space, envisioning a place enveloped in a soft unreality where one can simply surrender to the unfolding present."]}}},{"no":"004","title":"Inter●Structure","period":"2025","type":"Final project","tag":"Housing","cover":0,"sheets":[{"img":"bd99f7daaf597a18b03f2c5c57aa329b","no":"01","t":"Plan detail","s":"","ar":1},{"img":"1285792eeba6f398a3f60963e2af03fa","no":"02","t":"Site plan","s":"","ar":0.7333},{"img":"f1c8a0ba86ac8ad26c2a48b3b781620f","no":"03","t":"Structural frame","s":"","ar":1.4162},{"img":"e60ad8d0f54a3cc30e4e6b392f27eab7","no":"04","t":"Tower frame study","s":"","ar":0.9847},{"img":"8897fa489c632946dc181fbbabbb18c5","no":"05","t":"Balconies","s":"","ar":1.2812}],"text":{"ja":{"title":"骨組みとしての住棟","body":["川沿いに伸びる一本の長い住棟。円形の中庭を一定の間隔で挟み込み、住戸と共用の場が交互に現れる。","構造フレームを外に露出させ、設備や階段、植栽が後から取り付いていく余地を残した。建物を完成品ではなく、住み手が手を加え続ける骨組みとして考えている。"]},"en":{"title":"A Frame to Live In","body":["One long housing block runs along the river. Round courtyards are set into it at a steady rhythm, so homes and shared spaces alternate.","The structural frame is left exposed, with room for services, stairs and planting to attach over time. The building is treated as a frame its residents keep adding to, not a finished object."]}}},{"no":"003","title":"Chain Reaction","period":"","type":"","tag":"","cover":0,"sheets":[{"img":"713b3dbd776db4fd858a8d153de32d6e","no":"01","t":"","s":"","ar":1.3333},{"img":"dbb53f037fc31fbc98532f29c973313f","no":"02","t":"IMG_8745","s":"","ar":0.75},{"img":"fd51fb2c117b4b0709b4d8ebf0d653c4","no":"03","t":"IMG_8778","s":"","ar":1.3333},{"img":"cc8d91ab719dae55dc47f52bfa751f18","no":"04","t":"IMG_8793","s":"","ar":1.3333},{"img":"d1124dc45eea7464e135bd85b3740525","no":"05","